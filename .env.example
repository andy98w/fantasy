# Copy to .env. Never commit the populated file or paste cookies into chat.
ESPN_LEAGUE_ID=1834203755
ESPN_SEASON=2027
ESPN_TEAM_ID=3
ESPN_S2=
ESPN_SWID=
# Explicit demo mode. Change to live after a successful authenticated sync.
DATA_MODE=demo
# Optional locally; required for hosted web + sync services.
DATABASE_URL=
SNAPSHOT_PATH=data/league.json

# Hosted worker: set 30 to keep 24 recent + daily snapshots, latest raw response.
# 0 disables deletion. Back up an existing database before enabling.
SNAPSHOT_RETENTION_DAYS=0
